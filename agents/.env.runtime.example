# ===========================================
# AgentCore Runtime 環境変数テンプレート
#
# このファイルを .env.runtime にコピーして値を設定してください。
# .env.runtime は .gitignore に含まれており、コミットされません。
#
# 使い方:
#   cp .env.runtime.example .env.runtime
#   # 値を編集
#   ./scripts/set_env.sh
# ===========================================

# Bedrock モデル ID
MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# ログレベル
LOG_LEVEL=INFO

# Tavily API キー（ニュース拡張検索、オプション）
# https://tavily.com/ でアカウント作成後に取得
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
